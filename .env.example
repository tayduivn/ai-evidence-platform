# ==============================================================================
# AI Evidence & Accountability Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values as appropriate for your deployment.

# ------------------------------------------------------------------------------
# 1. immudb (Cryptographic Immutable Ledger Store)
# ------------------------------------------------------------------------------
IMMUDB_ADDRESS=immudb
IMMUDB_PORT=3324
IMMUDB_DATABASE=defaultdb
IMMUDB_USERNAME=immudb
IMMUDB_PASSWORD=immudb

# ------------------------------------------------------------------------------
# 2. Upstream Mock LLM
# ------------------------------------------------------------------------------
MOCK_LLM_PORT=8080
UPSTREAM_LLM_URL=http://mock-llm:8080

# ------------------------------------------------------------------------------
# 3. Ledger Worker Daemon
# ------------------------------------------------------------------------------
LEDGER_PORT=8083
LEDGER_SERVICE_URL=http://ledger-worker:8083
LEDGER_QUEUE_CAPACITY=50000
LEDGER_BATCH_SIZE=100
LEDGER_FLUSH_INTERVAL_MS=50
WAL_DIR=/var/lib/ledger/wal

# Optional RFC 3161 External Timestamp Authority
RFC3161_TSA_URL=
ANCHOR_INTERVAL_SEC=3600

# ------------------------------------------------------------------------------
# 4. AI Gateway & ML Ingest Service
# ------------------------------------------------------------------------------
GATEWAY_PORT=8081
# Path to JSON file containing registered AI systems (empty = default in-memory registry)
REGISTRY_FILE_PATH=

# ------------------------------------------------------------------------------
# 5. Human-in-the-Loop Approval UI & Pluggable Signer
# ------------------------------------------------------------------------------
APPROVAL_PORT=8082
APPROVAL_QUEUE_CAPACITY=1000
MIN_DWELL_TIME_SECONDS=10
